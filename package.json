{
  "name": "andersseen-stack-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @andersseen/www dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:run": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck lint test",
    "e2e": "pnpm --filter @andersseen/www e2e",
    "e2e:ui": "pnpm --filter @andersseen/www e2e:ui",
    "format": "pnpm --filter @andersseen/www format",
    "format:check": "pnpm --filter @andersseen/www format:check",
    "deploy:www": "pnpm --filter @andersseen/www deploy"
  },
  "devDependencies": {
    "turbo": "^2.6.3"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.0.0",
      "vitest": "^4.1.0"
    }
  }
}
