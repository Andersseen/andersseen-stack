{
  "name": "andersseen-stack",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.1"
  },
  "scripts": {
    "ng": "ng",
    "dev": "vite",
    "start": "pnpm run dev",
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint . --ext .ts,.html",
    "lint:fix": "eslint . --ext .ts,.html --fix",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "check": "pnpm run typecheck && pnpm run lint",
    "format": "prettier --write \"src/**/*.{ts,html,css,json,md}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json,md}\" \"e2e/**/*.ts\"",
    "preview": "node dist/analog/server/index.mjs"
  },
  "private": true,
  "dependencies": {
    "@analogjs/content": "^2.5.1",
    "@lumen/icons": "file:../lumen-icons/packages/icons",
    "@voltui/components": "file:../volt-ui/dist/volt",
    "angular-movement": "file:../angular-movement/dist/movement",
    "quartz-headless": "file:../quartz/dist/quartz",
    "@analogjs/router": "^2.5.1",
    "@angular/animations": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@tailwindcss/vite": "^4.1.4",
    "front-matter": "^4.0.2",
    "h3": "^1.13.0",
    "marked": "^15.0.7",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-highlight": "^2.2.1",
    "marked-mangle": "^1.1.10",
    "postcss": "^8.5.3",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.4",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.5.1",
    "@analogjs/vite-plugin-angular": "^2.5.1",
    "@analogjs/vitest-angular": "^2.5.1",
    "@angular-eslint/eslint-plugin": "^19.3.0",
    "@angular-eslint/eslint-plugin-template": "^19.3.0",
    "@angular-eslint/template-parser": "^19.3.0",
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/angular": "^17.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.25.0",
    "jsdom": "^22.0.0",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.31.0",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "$vitest"
  }
}
