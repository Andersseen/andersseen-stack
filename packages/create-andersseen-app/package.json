{
  "name": "create-andersseen-app",
  "version": "0.0.0",
  "type": "module",
  "description": "Create a new Andersseen Stack application.",
  "bin": {
    "create-andersseen-app": "./bin/create-andersseen-app.mjs"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
