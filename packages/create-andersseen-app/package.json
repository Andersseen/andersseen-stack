{
  "name": "create-andersseen-app",
  "version": "0.1.0",
  "type": "module",
  "description": "Scaffold a new Angular + Analog.js application with the Andersseen Stack (Quartz, Volt UI, Lumen Icons).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/andersseen-stack.git",
    "directory": "packages/create-andersseen-app"
  },
  "homepage": "https://github.com/Andersseen/andersseen-stack#readme",
  "bugs": {
    "url": "https://github.com/Andersseen/andersseen-stack/issues"
  },
  "keywords": [
    "angular",
    "analog",
    "analogjs",
    "starter",
    "cli",
    "generator",
    "dashboard",
    "landing",
    "typescript"
  ],
  "bin": {
    "create-andersseen-app": "./bin/create-andersseen-app.mjs"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm run build && vitest run test",
    "test:generated": "pnpm run build && node scripts/generated-app-smoke.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "release:check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run verify:pack && pnpm run test:generated",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run verify:pack"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.25.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.31.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
